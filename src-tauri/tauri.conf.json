{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "刻忆",
  "mainBinaryName": "daymark",
  "version": "0.2.0",
  "identifier": "app.daymark.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "刻忆",
        "width": 960,
        "height": 680,
        "minWidth": 760,
        "minHeight": 520,
        "center": true,
        "create": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "shortDescription": "重要日期主动提醒",
    "longDescription": "生日、纪念日只录入一次，农历自动换算，提前一个月、一周和当天主动提醒。",
    "windows": {
      "webviewInstallMode": { "type": "downloadBootstrapper" },
      "nsis": {
        "installMode": "currentUser",
        "languages": ["SimpChinese"],
        "displayLanguageSelector": false
      }
    }
  },
  "plugins": {
    "updater": {
      "endpoints": ["https://github.com/kekemao00/daymark/releases/latest/download/latest.json"],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDQxOEE3RTZFNEIyQUFERkEKUldUNnJTcExibjZLUVRFa0RxZ20xeHpkZCs1cUVUTktmVXA3TDIrSUFmNHc3RGp2cDRwUXhod3MK",
      "windows": { "installMode": "passive" }
    }
  }
}
